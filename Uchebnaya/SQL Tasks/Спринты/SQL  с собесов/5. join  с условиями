--- task 3
select o.operation_id,
o.amount*r.rate as amount_rub
from operations o join rates r 
on o.currency=r.currency
and  o.operation_dt = r.rate_dt

task 4
select o.order_id, o.client_id, 
c.segment
from orders o join client_segments c
on c.client_id=o.client_id 
and o.order_dt>=c.valid_from
and  o.order_dt<c.valid_to   


