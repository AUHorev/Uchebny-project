WITH ordered AS (
    SELECT user_id,
           start_dt,
           end_dt,
           MAX(end_dt) OVER (
               PARTITION BY user_id
               ORDER BY start_dt, end_dt
               ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
           ) AS max_previous_end
    FROM subscriptions
),
marked AS (
    SELECT *,
           CASE
               WHEN max_previous_end IS NULL
                 OR start_dt > max_previous_end + 1
               THEN 1 ELSE 0
           END AS is_new_island
    FROM ordered
),
grouped AS (
    SELECT *,
           SUM(is_new_island) OVER (
               PARTITION BY user_id
               ORDER BY start_dt, end_dt
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
           ) AS island_id
    FROM marked
)
SELECT user_id,
       MIN(start_dt) AS period_start,
       MAX(end_dt) AS period_end,
       MAX(end_dt) - MIN(start_dt) + 1 AS days_cnt
FROM grouped
GROUP BY user_id, island_id
ORDER BY user_id, period_start;