WITH activity_days AS (
    SELECT DISTINCT user_id, activity_dt::date AS activity_dt
    FROM user_activity
),
numbered AS (
    SELECT user_id,
           activity_dt,
           activity_dt
               - (ROW_NUMBER() OVER (
                     PARTITION BY user_id
                     ORDER BY activity_dt
                 ))::int AS island_key
    FROM activity_days
)
SELECT user_id,
       MIN(activity_dt) AS island_start,
       MAX(activity_dt) AS island_end,
       COUNT(*) AS days_cnt
FROM numbered
GROUP BY user_id, island_key
ORDER BY user_id, island_start;


--- task 2 --- позднее
WITH marked AS (
    SELECT order_id,
           changed_at,
           status,
           CASE
               WHEN status = LAG(status) OVER (
                   PARTITION BY order_id
                   ORDER BY changed_at
               ) THEN 0
               ELSE 1
           END AS is_new_island
    FROM order_status_history
),
grouped AS (
    SELECT *,
           SUM(is_new_island) OVER (
               PARTITION BY order_id
               ORDER BY changed_at
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
           ) AS island_id
    FROM marked
)
SELECT order_id,
       status,
       MIN(changed_at) AS period_start,
       MAX(changed_at) AS period_end,
       COUNT(*) AS status_events
FROM grouped
GROUP BY order_id, island_id, status
ORDER BY order_id, period_start;

