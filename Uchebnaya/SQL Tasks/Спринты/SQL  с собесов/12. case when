-- task 5
SELECT sale_id,
CASE channel_code
WHEN 'W' THEN 'web'
WHEN 'M' THEN 'mobile'
ELSE 'partner' END AS channel_name
FROM sales;

--- task 6
SELECT client_id,
CASE WHEN activation_date >= DATE '2026-04-23' THEN 'week'
WHEN activation_date >= DATE '2026-03-31' THEN 'month'
WHEN activation_date >= DATE '2025-04-30' THEN 'year'
ELSE 'old' END AS activation_segment
FROM clients;


--- task 7
SELECT client_id,
CASE WHEN days_overdue >= 30 OR debt_amount >= 5000 THEN 'high'
WHEN days_overdue > 0 THEN 'medium'
ELSE 'low' END AS risk_group
FROM debts;

