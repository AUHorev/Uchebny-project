   -- task 10
WITH x AS (
SELECT event_dt,
LEAD(event_dt) OVER (ORDER BY event_dt) AS next_event_dt
FROM calendar_events
)
SELECT event_dt
FROM x
WHERE next_event_dt IS NOT NULL
AND next_event_dt <> event_dt + INTERVAL '1 day';