task 3
select produkt_id, price, changet_at
price - lag(price) over ( partition by product_id order by change_at) as prev_price
from price_history

task 4
WITH x AS (
    SELECT
        user_id,
        event_dt,
        LAG(event_dt) OVER (
            PARTITION BY user_id
            ORDER BY event_dt
        ) AS prev_event
    FROM events
)

SELECT *
FROM x
WHERE event_dt - prev_event > 7;

--- task 6 
with A as (
    select ticket_id, changed_at, status,
    lag(status) over (partition by ticket_id order by changed_at) as prev_status
    from ticket_status)
    select *
    from A 
    where prev_status is null or status <> prev_status


