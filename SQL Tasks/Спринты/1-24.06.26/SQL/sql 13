SELECT
    c.name,                                 -- Имя персонажа — по нему будем группировать и показывать в отчёте
    COUNT(*) AS events_cnt                 -- Считаем, сколько записей об участии в событиях есть для этого персонажа
FROM event_participants ep                 -- Берём таблицу участия персонажей в событиях (основная таблица для подсчёта)
JOIN characters c                         -- Присоединяем таблицу персонажей, чтобы получить их имена
    ON c.character_id = ep.character_id   -- Связываем по ID: находим персонажа для каждой строки участия
GROUP BY c.name                           -- Агрегируем: одна строка на имя персонажа, суммируем все его участия
ORDER BY events_cnt DESC, c.name          -- Сортируем: сначала по убыванию числа событий (самые активные — вверху),
                                          -- при равном числе событий — по алфавиту имени
LIMIT 10;   -- Оставляем только топ‑10 самых активных персонажей

