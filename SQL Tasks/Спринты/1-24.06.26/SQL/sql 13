SELECT issued_by,
       COUNT(*) quests_cnt,
       ROUND(AVG(COALESCE(reward_gold,0)),3) avg_reward,
       ROUND(1.0*SUM(CASE WHEN success=1 THEN 1 ELSE 0 END)/NULLIF(COUNT(*),0),4) success_rate
  FROM quests
  WHERE success IS NOT NULL
  GROUP BY issued_by;


task 4
WITH qe AS (                                  -- CTE 1: базовая агрегация по квестам
    SELECT
        q.quest_id,                          -- ID квеста — ключ группировки
        COALESCE(q.reward_gold, 0) AS reward-- Награда: NULL → 0, чтобы не ломать расчёты
        AVG(e.risk_level) AS avg_risk       -- Средний риск по всем событиям квеста
    FROM quests q                            -- Таблица квестов
    JOIN quest_events x                      -- Связующая таблица квест–событие
        ON x.quest_id = q.quest_id          -- Привязываем события к квесту
    JOIN events e                             -- Таблица событий (берём risk_level)
        ON e.event_id = x.event_id           -- Привязываем детали события
    GROUP BY q.quest_id                      -- Одна строка на квест: считаем агрегаты
),                                           -- Разделитель между CTE
sc AS (                                       -- CTE 2: расчёт метрики «награда/риск»
    SELECT
        quest_id,                            -- Переносим ID
        reward,                               -- Награда (уже без NULL)
        avg_risk,                            -- Средний риск
        (1.0 * reward / NULLIF(avg_risk, 0)) AS rpr  -- RPR: 1.0 → вещественное деление; NULLIF → защита от деления на 0
    FROM qe                                   -- Источник — предыдущий CTE
)                                             -- Конец определения CTE
SELECT *                                      -- Основной запрос: вывод всех колонок из sc
FROM sc
WHERE rpr > (                                 -- Фильтр: оставляем только «выше среднего»
    SELECT AVG(rpr)                           -- Подзапрос: считаем среднее RPR по всем строкам sc
    FROM sc                                   -- Из того же CTE (самоссылка)
);

