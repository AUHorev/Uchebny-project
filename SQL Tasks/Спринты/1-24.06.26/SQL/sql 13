-- 2. Сводка по сегментам: chars_cnt и avg_events.
WITH x AS (
    SELECT ch.character_id,
       CASE
         WHEN ch.alignment='evil' THEN 'threat'
         WHEN ch.is_magical=1 THEN 'special'
         ELSE 'standard'
       END AS segment,
       COUNT(ep.event_id) events_cnt
  FROM characters ch
  LEFT JOIN event_participants ep
    ON ep.character_id=ch.character_id
  GROUP BY ch.character_id,segment)
SELECT segment,
       COUNT(*) chars_cnt,
       ROUND(AVG(events_cnt),3) avg_events
  FROM x
  GROUP BY segment;


