SELECT
    l.name,                                 -- Название локации (по нему и группируем, и выводим)
    SUM(e.risk_level) AS risk_sum          -- Суммируем risk_level всех событий в этой локации
FROM events e                               -- Берём таблицу событий как основу
JOIN locations l                            -- Присоединяем таблицу локаций
    ON l.location_id = e.location_id       -- Связываем по ID локации
GROUP BY l.name                             -- Агрегируем: одна строка на локацию, считаем сумму рисков
ORDER BY risk_sum DESC, l.name              -- Сортируем: сначала по убыванию риска, потом по имени локации
LIMIT 5;                                    -- Оставляем только топ‑5 локаций по суммарному риску
