SELECT *                                                   -- Выводим все колонки из подзапроса (унифицированный список объектов)
FROM (
    SELECT
        'character' AS obj_type,                          -- Тип объекта: фиксированная строка 'character'
        CAST(character_id AS TEXT) AS obj_id,            -- ID персонажа приводим к тексту, чтобы он совпадал по типу с другими ID
        name AS title,                                     -- Имя персонажа показываем как «заголовок» объекта
        strength_level AS score                            -- Уровень силы — это наша метрика «значимости» для сортировки
    FROM characters
    UNION ALL                                             -- Объединяем строки из разных таблиц, сохраняя дубликаты (если они есть)
    SELECT
        'location' AS obj_type,                           -- Тип объекта: 'location'
        CAST(location_id AS TEXT) AS obj_id,               -- ID локации в текстовом виде
        name AS title,                                     -- Название локации как заголовок
        danger_level AS score                              -- Уровень опасности — наша метрика для локации
    FROM locations
    UNION ALL
    SELECT
        'event' AS obj_type,                              -- Тип объекта: 'event'
        CAST(event_id AS TEXT) AS obj_id,                 -- ID события в текстовом виде
        event_type AS title,                                -- Тип события как заголовок (вместо имени)
        risk_level AS score                                 -- Уровень риска — метрика для события
    FROM events
) u                                                        -- Алиас для всего объединённого набора строк
ORDER BY
    score DESC,                                            -- Сначала самые «сильные/опасные/рискованные» объекты
    obj_type,                                              -- Потом сортируем по типу (чтобы группы шли в понятном порядке)
    obj_id;                                                -- Внутри типа — по ID (для детерминированного порядка)
LIMIT 15;           

