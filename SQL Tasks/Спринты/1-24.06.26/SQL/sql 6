task 9

SELECT *  -- выбираем все поля из таблицы
FROM quests  -- из таблицы quests
WHERE LENGTH(quest_name) > (  -- где длина названия больше, чем
    SELECT AVG(LENGTH(quest_name))  -- среднее значение длины названий
    FROM quests  -- из той же таблицы quests
);
