task 4


SELECT 
    quest_name,
    LENGTH(quest_name) AS len_q
FROM quests q 
ORDER BY len_q DESC;

task 5

SELECT 
    CONCAT(
        quest_name, 
        ' | reward=', 
        reward_gold
    ) AS label
FROM quests
WHERE reward_gold IS NOT NULL;

