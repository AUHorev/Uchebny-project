--- task 1 


SELECT
    event_id,                          -- Выбираем идентификатор события
    risk_level,                       -- Выбираем текущий уровень риска
    CASE 
        WHEN risk_level >= 8 THEN 1   -- Если уровень риска 8 или выше — ставим 1 (высокий риск)
        ELSE 0                        -- Иначе ставим 0 (не высокий риск)
    END AS is_high_risk               -- Присваиваем имя новой колонке
FROM events                           -- Данные берём из таблицы events
ORDER BY is_high_risk DESC;           -- Сортируем: сначала строки с высоким риском (1), потом с низким (0)


select
event_id,
risk_level,
case when risk_level>=8 then 1 else 0 end as is_high_risk
from events 
order by is_high_risk desc

-----   task 2

select
location_id,
event_type,
sum(case when risk_level>=8 then 1 else 0 end) as high_risk
from events 
group by location_id, event_type
order by high_risk desc

