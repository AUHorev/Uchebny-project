SELECT
    quest_id,
    COALESCE(reward_gold, 0) AS reward,
    CASE
        WHEN COALESCE(reward_gold, 0) >= 200 THEN 'high'
        WHEN COALESCE(reward_gold, 0) >= 100 THEN 'mid'
        ELSE 'low'
    END AS bucket
FROM quests;    

