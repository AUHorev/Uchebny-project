tasc 3 средняя сила по alignment (окно)

SELECT
    character_id,          -- выбираем ID персонажа
    name,                  -- выбираем имя персонажа
    strength_level,        -- выбираем уровень силы
    ROUND(                 -- округляем результат до 2 знаков после запятой
        AVG(strength_level) -- вычисляем среднее значение силы
        OVER(              -- для оконных функций
            PARTITION BY alignment  -- группируем по выравниванию (alignment)
        ),
        2                  -- количество знаков после запятой
    ) AS avg_s             -- присваиваем псевдоним результату
FROM characters;           -- из таблицы characters

----task 4  сила выше средней по виду персонажа


WITH x AS (
    SELECT 
        *,                  -- выбираем все поля из таблицы characters
        AVG(strength_level) -- вычисляем среднее значение силы
            OVER (          -- для оконных функций
                PARTITION BY species  -- группируем по видам
            ) as avg_s      -- присваиваем псевдоним среднему значению
    FROM characters         -- из таблицы characters
)
SELECT 
    name,                   -- имя персонажа
    species,                -- вид персонажа
    strength_level         -- уровень силы
FROM x                     -- из временного набора данных x
WHERE strength_level > avg_s;  -- условие: сила больше средней по виду

task 5

SELECT
    quest_id,          -- ID квеста
    issued_by,         -- кто выдал квест
    reward_gold,       -- награда в золоте
    ROUND(
        1.0 * reward_gold 
        / SUM(reward_gold) OVER(PARTITION BY issued_by),  -- вычисляем долю
        4                                                -- округляем до 4 знаков
    ) AS share_in_issuer  -- доля от общей награды выдавшего
FROM quests
WHERE reward_gold IS NOT NULL



TASK 7 
WITH d AS (  -- 1. Создаем Common Table Expression (CTE) с именем d
    SELECT 
        start_day,  -- 2. Выбираем дату начала события
        COUNT(*) AS cnt  -- 3. Считаем количество событий для каждой даты
    FROM events e  -- 4. Берём данные из таблицы events
    GROUP BY e.start_day  -- 5. Группируем результаты по дате
)
SELECT 
    start_day,  -- 6. Выводим дату
    cnt,  -- 7. Выводим количество событий за день
    SUM(cnt) OVER (  -- 8. Вычисляем накопительную сумму
        ORDER BY start_day  -- 9. Сортируем по дате
    ) AS cum_cnt  -- 10. Присваиваем псевдоним накопительной сумме
FROM d;  -- 11. Берём данные из CTE d  

