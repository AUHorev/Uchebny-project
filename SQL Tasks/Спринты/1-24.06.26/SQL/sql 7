SELECT  -- 1. Базовый оператор выбора данных
    DISTINCT event_type,  -- 2. Выбираем уникальные типы событий
    ROUND(  -- 3. Начинаем функцию округления
        1.0 *  -- 4. Умножаем на 1.0 для получения десятичного результата
        COUNT(*) OVER (  -- 5. Начинаем подсчет количества записей
            PARTITION BY event_type  -- 6. Группируем по типу события
        ) /  -- 7. Делим на
        COUNT(*) OVER (),  -- 8. Общее количество записей
        4  -- 9. Округляем до 4 знаков после запятой
    ) AS share  -- 10. Присваиваем псевдоним результату
FROM events;  -- 11. Указываем таблицу-источник


SELECT 
    event_type,
    ROUND(
        1.0 * COUNT(*) / (SELECT COUNT(*) FROM events),
        4
    ) AS share
FROM events
GROUP BY event_type;

TASK 9 

WITH r AS (  -- Создаем временное представление (CTE)
    SELECT 
        location_id,  -- идентификатор локации
        event_id,     -- идентификатор события
        risk_level,   -- уровень риска
        ROW_NUMBER() OVER (  -- присваиваем порядковый номер
            PARTITION BY location_id  -- для каждой локации отдельно
            ORDER BY risk_level DESC, event_id  -- сортируем по убыванию риска
        ) AS rn  -- сохраняем номер в колонку rn
    FROM events  -- берем данные из таблицы events
)
SELECT *  -- выбираем все данные
FROM r  -- из нашего CTE
WHERE rn = 1;  -- оставляем только первую запись для каждой локации

WITH r AS (
    SELECT location_id,
       event_id,
       risk_level,
       ROW_NUMBER() OVER (PARTITION BY location_id ORDER BY risk_level DESC, event_id) AS rn
  FROM events )
SELECT *
  FROM r
  WHERE rn=1

