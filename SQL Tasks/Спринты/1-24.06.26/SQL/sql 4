--- tasc 1

select 
e.event_id,
e.event_type,
l.name,
l.type
from events e 
join locations l 
on l.location_id =e.location_id 

--- tasc 2
select 
e.event_id,
e.event_type,
c.name
from events e
join event_participants ep 
on e.event_id = ep.event_id
join "characters" c 
on c.character_id = ep.character_id 
where c.name = 'Donkey'
 
